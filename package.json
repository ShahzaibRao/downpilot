{
  "author": "Rao Shahzaib",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "vue": "^3.5.44"
  },
  "description": "DownPilot — creator-first download manager (Quick + Prospect modes)",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.0.0"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "name": "downpilot",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "manifest": "node scripts/gen-deps-manifest.mjs --reuse-hashes",
    "sidecar:build": "cd backend && go build -o bin/dp-deps ./cmd/dp-deps",
    "sidecar:build:win": "cd backend && go build -o bin/dp-deps.exe ./cmd/dp-deps",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:publish": "npm run build && electron-builder --win --publish always"
  },
  "version": "0.1.0",
  "build": {
    "appId": "site.raoshahzaib.downpilot",
    "productName": "DownPilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "pot/**/*",
      "backend/bin/**/*",
      "!**/node_modules/*"
    ],
    "extraResources": [
      {
        "from": "pot",
        "to": "pot",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/bin",
        "to": "backend/bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DownPilot-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "ShahzaibRao",
      "repo": "downpilot"
    }
  }
}
